# Consumed by Cloudflare at deploy time — this file is never served itself.
# Content-Type is set explicitly rather than left to extension sniffing, since
# calendar clients are picky about it. max-age is deliberately short: the
# schedule can be edited mid-week, and subscribers should pick that up the
# same day rather than holding a stale copy.
/lucene-schedule.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

{
  // Assets-only Worker: no `main`, no server code. `wrangler deploy` uploads
  // ONLY what is inside `assets.directory` — the sync scripts, run state and
  // known_titles.txt sitting next to it in this (private) repo are cloned by
  // the builder and never served. That is what lets one private repo hold
  // both the machinery and the one file the public subscribes to.
  "name": "lucene",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./public"
  }
}
